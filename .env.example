# Database
DATABASE_URL=postgresql://seatlock:seatlock_dev@localhost:5432/seatlock

# Redis
REDIS_URL=redis://localhost:6379

# Application
API_PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication
JWT_SECRET=change-me-in-production-use-a-64-char-random-string
JWT_EXPIRES_IN=7d

# Hold configuration
HOLD_DURATION_SECONDS=600

# Payment Provider ('mock' or 'stripe')
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=whsec_test_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
